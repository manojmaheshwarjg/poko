# Copy to .env.local and fill in. Nothing calls the API until these are set.
GROQ_API_KEY=

# Required, no default. Groq's catalogue changes, so pick one your key can reach:
#   node scripts/list-models.mjs
GROQ_MODEL=

# Only set this if a reasoning model leaks its thinking into the response and
# breaks the JSON parse. Non-reasoning models reject the parameter, so it is
# unset by default.
# GROQ_REASONING_FORMAT=hidden

# Origin allowed to call the planner. The dev harness runs here.
COPILOT_ALLOWED_ORIGIN=http://localhost:4500
